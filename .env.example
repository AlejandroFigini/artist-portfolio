# ============================================================
#  artist-portfolio — variables de entorno
#  Copiá este archivo a `.env` y completá los valores.
#  La API vive dentro de Next (app/api/*). No hay backend Express aparte.
# ============================================================

# --- Base de datos (Postgres) -------------------------------
# PROD (Railway): pegá la URL del servicio Postgres (referencia interna o pública).
# LOCAL: tu Postgres local, ej:
#   postgresql://postgres:postgres@localhost:5432/artistportfolio
# Sin DATABASE_URL -> modo MOCK (no persiste; el front usa localStorage).
DATABASE_URL=

# SSL para Postgres remoto: por defecto verifica certificados (seguro).
# En Railway con URL pública, ponelo en false para aceptar certs auto-firmados.
# En conexiones internas de Railway o localhost, esta variable se ignora (no usa SSL).
DB_SSL_REJECT_UNAUTHORIZED=

# --- Cloudinary (hosting de imágenes/videos) ----------------
# Completá SOLO en producción. En LOCAL dejalos VACÍOS -> las subidas se guardan
# en public/uploads (gitignoreado) y NO tocan Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Usuarios / login (seed inicial) ------------------------
# 2 usuarios fijos, sembrados en DB al primer boot si la tabla users está
# vacía. Después cada uno cambia sus credenciales desde la UI (tuerca admin
# -> Mi cuenta) y activa su 2FA (QR propio); estas vars quedan solo como
# semilla inicial.
USER1_NAME=
USER1_PASS=
USER2_NAME=
USER2_PASS=

# --- Contacto (Resend) -----------------------------------------
# API Key de resend.com (plan gratuito: 100 emails/día).
# Sin esta key → los mensajes se guardan en DB pero NO se envían por email.
# NOTA: los emails SOLO se envían en producción (NODE_ENV=production).
# En desarrollo local, los mensajes se guardan en DB pero no se envían.
RESEND_API_KEY=
# Dirección "From" verificada en Resend (dominio propio).
# Requiere verificar tu dominio en resend.com/domains (registros DNS).
# Ejemplo: contacto@luciamontana.com
# Si está vacío, usa onboarding@resend.dev (funcional pero genérico).
RESEND_FROM_EMAIL=
# El email DESTINO (donde llegan los mensajes) se configura desde
# el panel de admin → Site Settings → Social Networks → Email.
# Soporta dos correos separados por coma: "email1@x.com, email2@x.com"

# --- Captcha (Cloudflare Turnstile) ----------------------------
# Site Key pública (va al frontend) y Secret Key (solo backend).
# Sin estas keys → el captcha no se muestra y el formulario funciona sin él.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Tareas Automáticas (Cron) ---------------------------------
# Contraseña para proteger rutas de automatización (ej. reporte de tráfico).
# Generá cualquier texto largo/seguro.
CRON_SECRET=
